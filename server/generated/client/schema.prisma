generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum PaymentMethod {
  COD
  ONLINE
  MANUAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum NotificationType {
  ORDER_STATUS
  PAYMENT
  PROMOTION
  SYSTEM
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  // Better Auth stores credential hashes in Account.password.
  // Keep this legacy column nullable so it does not block new user creation.
  role      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  addresses     UserAddress[]
  notifications Notification[]

  emailVerified Boolean   @default(false)
  image         String?
  status        String?   @default("active")
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  description   String   @db.Text
  price         Decimal
  discountPrice Decimal  @map("discount_price")
  categoryId    Int      @map("category_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  reviews  Review[]

  @@map("products")
}

model ProductVariant {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  sku       String @unique
  size      String
  color     String
  stock     Int

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  imageUrl  String  @map("image_url")
  publicId  String? @map("public_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
  @@map("carts")
}

model CartItem {
  id               Int @id @default(autoincrement())
  cartId           Int @map("cart_id")
  productVariantId Int @map("product_variant_id")
  quantity         Int

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productVariantId])
  @@map("cart_items")
}

model Order {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  subtotal              Decimal   @default(0)
  discountTotal         Decimal   @default(0) @map("discount_total")
  deliveryFee           Decimal   @default(0) @map("delivery_fee")
  totalPrice            Decimal   @map("total_price")
  orderStatus           String    @map("order_status")
  paymentMethod         String    @map("payment_method")
  paymentStatus         String    @map("payment_status")
  stripePaymentIntent   String?   @unique @map("stripe_payment_intent")
  stripeCheckoutSession String?   @unique @map("stripe_checkout_session")
  customerName          String    @map("customer_name")
  phone                 String
  address               String    @db.Text
  isInsideCity          Boolean   @default(true) @map("is_inside_city")
  deliveryInstructions  String?   @map("delivery_instructions") @db.Text
  city                  String
  county                String?
  country               String    @default("Bangladesh")
  postalCode            String    @map("postal_code")
  inventoryRestoredAt   DateTime? @map("inventory_restored_at")
  cancelledAt           DateTime? @map("cancelled_at")
  refundedAt            DateTime? @map("refunded_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user               User                 @relation(fields: [userId], references: [id])
  items              OrderItem[]
  payments           PaymentTransaction[]
  inventoryMovements InventoryMovement[]

  @@index([userId, createdAt])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id               Int     @id @default(autoincrement())
  orderId          Int     @map("order_id")
  productVariantId Int     @map("product_variant_id")
  price            Decimal
  quantity         Int
  productTitle     String  @map("product_title")
  sku              String
  size             String
  color            String

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@map("order_items")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  rating    Int
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  isHidden  Boolean  @default(false) @map("is_hidden")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("reviews")
}

model PaymentTransaction {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  provider          String
  type              String
  status            String
  amount            Decimal
  currency          String
  providerReference String?  @unique @map("provider_reference")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("payment_transactions")
}

model WebhookEvent {
  id          Int       @id @default(autoincrement())
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model InventoryMovement {
  id               Int      @id @default(autoincrement())
  productVariantId Int      @map("product_variant_id")
  orderId          Int?     @map("order_id")
  quantity         Int
  reason           String
  createdAt        DateTime @default(now()) @map("created_at")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productVariantId, createdAt])
  @@index([orderId])
  @@map("inventory_movements")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Coupon {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  discountType   String    @default("percentage") @map("discount_type")
  discountAmount Decimal   @map("discount_amount")
  minOrderValue  Decimal?  @map("min_order_value")
  usageLimit     Int?      @map("usage_limit")
  usedCount      Int       @default(0) @map("used_count")
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("coupons")
}

model StoreSetting {
  id                    Int      @id @default(1)
  storeName             String   @default("NABIS FASHION") @map("store_name")
  tagline               String   @default("Luxury Bengali Panjabi, Sarees & Designer Attire")
  supportEmail          String   @default("support@nabisfashion.com") @map("support_email")
  supportPhone          String   @default("+880 1711 000 000") @map("support_phone")
  currency              String   @default("USD ($)")
  storeAddress          String   @default("House 45, Road 11, Banani, Dhaka, Bangladesh") @map("store_address")
  insideCityFee         Decimal  @default(10.00) @map("inside_city_fee")
  outsideCityFee        Decimal  @default(15.00) @map("outside_city_fee")
  freeShippingMinOrder  Decimal  @default(50.00) @map("free_shipping_min_order")
  estimatedDeliveryDays String   @default("2-4 Business Days") @map("estimated_delivery_days")
  enableCOD             Boolean  @default(true) @map("enable_cod")
  enableSSLCommerz      Boolean  @default(true) @map("enable_sslcommerz")
  enableStripe          Boolean  @default(true) @map("enable_stripe")
  vatTaxRate            String   @default("0.0%") @map("vat_tax_rate")
  metaTitle             String   @default("NABIS FASHION | Luxury Punjabis, Sarees & Ethnic Clothing") @map("meta_title")
  metaDescription       String   @default("Discover handcrafted Punjabi collections, designer Sarees, and premium fashion accessories at NABIS FASHION.") @map("meta_description")
  instagram             String   @default("https://instagram.com/nabisfashion")
  facebook              String   @default("https://facebook.com/nabisfashion")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  label     String   @default("Home")
  name      String
  phone     String
  street    String   @db.Text
  city      String
  state     String
  zip       String
  country   String   @default("Bangladesh")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Notification {
  id        String           @id @default(uuid())
  userId    Int              @map("user_id")
  type      NotificationType @default(SYSTEM)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

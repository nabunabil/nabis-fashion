# Database (Required)
# PostgreSQL connection string - get from your database provider (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Better Auth (Required)
# Secret key for signing tokens - generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here"
# Your API URL (use your Vercel deployment URL in production)
BETTER_AUTH_URL="http://localhost:5000"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App Support Email (Optional)
SUPPORT_EMAIL="support@nabisfashton.com"

# CORS (Required)
# Your frontend URL (use your Vercel frontend URL in production)
TRUSTED_ORIGIN="http://localhost:3000"

# Optional list of extra allowed origins separated by commas
TRUSTED_ORIGINS="http://localhost:3000"

# Stripe (Required for online payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="bdt"

# Email - Google SMTP (Optional)
# Use your Gmail address
SMTP_USER="your-email@gmail.com"
# Use App Password (not regular password) - Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Optional: Custom "from" address (defaults to SMTP_USER)
SMTP_FROM_EMAIL="your-email@gmail.com"

# Server (Optional - defaults shown)
PORT=5000
NODE_ENV=development

